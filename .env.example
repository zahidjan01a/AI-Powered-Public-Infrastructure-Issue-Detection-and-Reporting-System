# =========================================================
# AI-Powered Public Infrastructure Detection System
# Environment Variable Configuration Template
# =========================================================
#
# Copy this file to '.env' and populate with your personal API credentials.
# NOTE: Never commit your real '.env' file containing actual keys to Git!

# Optional: Google Gemini API Key for online LLM recommendation generation
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: OpenAI API Key (if using OpenAI LLM alternative)
# Obtain key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Streamlit Server Port & Address configuration (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
